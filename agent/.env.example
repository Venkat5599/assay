# Copy to .env and fill in. Keys are never committed.
RPC_URL=https://rpc.botchain.ai
CHAIN_ID=677

# BOT Chain mainnet (677). Settlement is bridged USDT - SIX decimals, not 18.
ASSET_REGISTRY=0xe33eE752dbb1724f6939A105cecFF2714F684172
FIRM_BID_MARKET=0x83f8C719854a561b38E85484568E59CD34d81525
LOAN_VAULT=0xCc18DFC9a339d9D1298dbD90617121Ce319D358E
STABLE_TOKEN=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
STABLE_DECIMALS=6

# One EOA per underwriter. Each escrows its own capital, so these hold real value.
AGENT_CONSERVATIVE_KEY=0x...
AGENT_SECTOR_KEY=0x...
AGENT_AGGRESSIVE_KEY=0x...

# Only needed by `bun run src/fund.ts --send` to stake the agents above.
FUNDER_KEY=0x...
AGENT_GAS_TARGET=0.05
AGENT_CAPITAL_TARGET=5000

# Judgment layer. Without a key the deterministic rubric runs instead, and every
# bid records which path produced it.
ANTHROPIC_API_KEY=

INTERVAL_MS=20000
